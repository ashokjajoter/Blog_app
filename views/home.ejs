<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("./partials/head") %>
    <title>Blog App | Stories Worth Your Time</title>

    <style>
        :root {
            --navy: #18263D;
            --navy-light: #263954;
            --gold: #C5A46D;
            --gold-light: #E4D0A8;
            --ivory: #F8F6F1;
            --white: #FFFFFF;
            --muted: #777C85;
        }

        body {
            background: var(--ivory);
            color: var(--navy);
            font-family: "Segoe UI", sans-serif;
            margin: 0;
        }

        /* Hero section */
        .hero-section {
            padding: 90px 0 75px;
            background: linear-gradient(
                135deg, #F8F6F1 0%, #F0E9DC 100%
            );
            border-bottom: 1px solid #E8E0D3;
        }

        .hero-label {
            color: #997641;
            text-transform: uppercase;
            letter-spacing: 4px;
            font-size: 12px;
            font-weight: 700;
        }

        .hero-title {
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(42px, 6vw, 72px);
            line-height: 1.12;
            font-weight: 700;
            letter-spacing: -2px;
            margin: 22px 0;
            color: var(--navy);
        }

        .hero-title span {
            color: #B18B50;
            font-style: italic;
        }

        .hero-description {
            max-width: 540px;
            color: #70747B;
            font-size: 17px;
            line-height: 1.9;
            margin-bottom: 30px;
        }

        .premium-btn {
            display: inline-block;
            padding: 14px 27px;
            background: var(--navy);
            color: white;
            text-decoration: none;
            border: 1px solid var(--navy);
            border-radius: 5px;
            font-weight: 600;
            transition: all .3s ease;
        }

        .premium-btn:hover {
            background: var(--gold);
            border-color: var(--gold);
            color: var(--navy);
            transform: translateY(-2px);
        }

        .hero-note {
            margin-top: 24px;
            font-size: 12px;
            color: #89847B;
            letter-spacing: 1px;
        }

        /* Blog section */
        .blog-section {
            padding: 70px 0 90px;
        }

        .section-kicker {
            color: #A17B43;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 3px;
            text-transform: uppercase;
        }

        .section-title {
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(30px, 4vw, 43px);
            font-weight: 700;
            margin-top: 10px;
            margin-bottom: 12px;
        }

        .section-description {
            color: var(--muted);
            margin-bottom: 35px;
        }

        .blog-grid {
            row-gap: 28px;
        }

        .blog-card {
            height: 100%;
            background: var(--white);
            border: 1px solid #ECE8E0;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(24, 38, 61, .04);
            transition: transform .35s ease,
                        box-shadow .35s ease;
        }

        .blog-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 18px 38px rgba(24, 38, 61, .12);
        }

        .blog-image-wrap {
            overflow: hidden;
            background: #EAE5DA;
        }

        .blog-image {
            width: 100%;
            height: 225px;
            object-fit: cover;
            display: block;
            transition: transform .5s ease;
        }

        .blog-card:hover .blog-image {
            transform: scale(1.05);
        }

        .blog-card-body {
            padding: 23px;
        }

        .blog-category {
            display: inline-block;
            color: #A17B43;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin-bottom: 12px;
        }

        .blog-title {
            font-family: Georgia, "Times New Roman", serif;
            font-size: 21px;
            font-weight: 700;
            line-height: 1.45;
            margin-bottom: 20px;
            color: var(--navy);
            overflow-wrap: anywhere;
        }

        .read-link {
            color: var(--navy);
            text-decoration: none;
            font-size: 13px;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 9px;
            border-bottom: 1px solid var(--gold);
            padding-bottom: 5px;
            transition: color .25s ease;
        }

        .read-link:hover {
            color: #A17B43;
        }

        .empty-state {
            background: white;
            padding: 55px 20px;
            text-align: center;
            border: 1px solid #ECE8E0;
            border-radius: 12px;
        }

        .site-footer {
            background: var(--navy);
            color: #D5D9E0;
            padding: 28px 0;
            font-size: 13px;
        }

        .footer-brand {
            font-family: Georgia, "Times New Roman", serif;
            color: var(--gold-light);
            font-size: 20px;
            font-weight: 700;
        }

        @media (max-width: 767px) {
            .hero-section {
                padding: 65px 0 55px;
            }

            .hero-title {
                letter-spacing: -1px;
            }

            .blog-section {
                padding: 50px 0 60px;
            }

            .blog-image {
                height: 210px;
            }
        }
    </style>
</head>

<body>
    <%- include("./partials/nav") %>

    <!-- Hero -->
    <section class="hero-section">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-9">
                    <div class="hero-label">
                        Ideas. Stories. Perspectives.
                    </div>

                    <h1 class="hero-title">
                        Stories worth<br>
                        your <span>time.</span>
                    </h1>

                    <p class="hero-description">
                        Discover fresh perspectives, thoughtful ideas,
                        and stories that inspire a different way of
                        thinking. Your next great read starts here.
                    </p>

                    <a href="#latest-stories" class="premium-btn">
                        Explore Stories &rarr;
                    </a>

                    <div class="hero-note">
                        CURATED IDEAS &bull; AUTHENTIC VOICES
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Blog cards -->
    <section class="blog-section" id="latest-stories">
        <div class="container">
            <div class="mb-5">
                <div class="section-kicker">The Journal</div>

                <h2 class="section-title">Latest Stories</h2>

                <p class="section-description">
                    Thoughtfully written. Beautifully presented.
                </p>
            </div>

            <div class="row row-cols-1 row-cols-sm-2
                        row-cols-lg-3 row-cols-xl-4 g-4 blog-grid">

                <% if (blogs && blogs.length > 0) { %>

                    <% blogs.forEach(blog => { %>
                        <div class="col">
                            <article class="blog-card">

                                <div class="blog-image-wrap">
                                    <img
                                        src="<%= blog.coverImageURL %>"
                                        alt="<%= blog.title %>"
                                        class="blog-image"
                                        loading="lazy"
                                    >
                                </div>

                                <div class="blog-card-body">
                                    <div class="blog-category">
                                        Featured Story
                                    </div>

                                    <h3 class="blog-title">
                                        <%= blog.title %>
                                    </h3>

                                    <a
                                        href="/blog/<%= blog._id %>"
                                        class="read-link"
                                    >
                                        Read Article <span>&rarr;</span>
                                    </a>
                                </div>

                            </article>
                        </div>
                    <% }); %>

                <% } else { %>

                    <div class="col-12">
                        <div class="empty-state">
                            <h3 class="section-title">
                                Your story begins here.
                            </h3>
                            <p class="section-description mb-0">
                                No blog posts yet. Check back soon
                                for something inspiring.
                            </p>
                        </div>
                    </div>

                <% } %>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="site-footer">
        <div class="container d-flex flex-column
                    flex-md-row justify-content-between
                    align-items-center gap-3">
            <div class="footer-brand">Blog App</div>

            <div>
                A little inspiration, one story at a time.
            </div>

            <div>&copy; <%= new Date().getFullYear() %> Blog App</div>
        </div>
    </footer>

    <%- include("./partials/script") %>
</body>
</html>