<!DOCTYPE html>
<html lang="en">
  <link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<head>
    <%- include("./partials/head") %>
    <title>Sign Up | Blog App</title>

    <style>
        :root {
            --navy: #18263D;
            --navy-light: #263954;
            --gold: #C5A46D;
            --gold-light: #E4D0A8;
            --ivory: #F8F6F1;
            --white: #FFFFFF;
            --muted: #777C85;
            --border: #E8E0D3;
        }

        body {
            background: var(--ivory);
            color: var(--navy);
            font-family: "Segoe UI", sans-serif;
            min-height: 100vh;
        }

        /* Signup page background */
        .signup-wrapper {
            min-height: calc(100vh - 70px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 55px 16px;
            background:
                radial-gradient(
                    circle at 10% 15%,
                    rgba(197, 164, 109, .12),
                    transparent 35%
                ),
                linear-gradient(135deg, #F8F6F1, #F0E9DC);
        }

        .signup-card {
            width: 100%;
            max-width: 480px;
            padding: 42px;
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(24, 38, 61, .09);
            animation: cardEnter .6s ease both;
        }

        @keyframes cardEnter {
            from {
                opacity: 0;
                transform: translateY(18px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .brand {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 11px;
            margin-bottom: 34px;
        }

        .brand-icon {
            width: 46px;
            height: 46px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--navy);
            color: var(--gold-light);
            border-radius: 10px;
            font-size: 23px;
        }

        .brand-name {
            font-family: Georgia, "Times New Roman", serif;
            font-size: 26px;
            font-weight: 700;
            color: var(--navy);
            line-height: 1.2;
        }

        .brand-tagline {
            color: #8D7959;
            font-size: 9px;
            letter-spacing: 2px;
            margin-top: 4px;
        }

        .signup-heading {
            font-family: Georgia, "Times New Roman", serif;
            font-size: 34px;
            font-weight: 700;
            letter-spacing: -.8px;
            text-align: center;
            margin-bottom: 12px;
            color: var(--navy);
        }

        .signup-description {
            text-align: center;
            color: var(--muted);
            font-size: 14px;
            line-height: 1.8;
            margin-bottom: 32px;
        }

        .form-label {
            font-size: 13px;
            font-weight: 600;
            color: var(--navy);
            margin-bottom: 9px;
        }

        .form-control {
            min-height: 49px;
            padding: 12px 15px;
            border: 1px solid #DEDCD6;
            border-radius: 7px;
            background: #FDFCF9;
            color: var(--navy);
            font-size: 14px;
            transition: border-color .25s ease,
                        box-shadow .25s ease,
                        background .25s ease;
        }

        .form-control::placeholder {
            color: #A3A4A7;
        }

        .form-control:focus {
            background: var(--white);
            border-color: var(--gold);
            box-shadow: 0 0 0 4px rgba(197, 164, 109, .15);
            outline: none;
        }

        .signup-btn {
            width: 100%;
            min-height: 50px;
            margin-top: 8px;
            background: var(--navy);
            border: 1px solid var(--navy);
            border-radius: 7px;
            color: var(--white);
            font-size: 14px;
            font-weight: 600;
            letter-spacing: .3px;
            transition: all .3s ease;
        }

        .signup-btn:hover {
            background: var(--gold);
            border-color: var(--gold);
            color: var(--navy);
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(197, 164, 109, .22);
        }

        .login-text {
            text-align: center;
            margin-top: 25px;
            margin-bottom: 0;
            font-size: 13px;
            color: var(--muted);
        }

        .login-link {
            color: #A17B43;
            font-weight: 700;
            text-decoration: none;
            transition: color .2s ease;
        }

        .login-link:hover {
            color: var(--navy);
            text-decoration: underline;
        }

        .signup-footer {
            text-align: center;
            margin-top: 25px;
            color: #89847B;
            font-size: 10px;
            letter-spacing: 2px;
        }

        @media (max-width: 576px) {
            .signup-wrapper {
                padding: 30px 15px;
            }

            .signup-card {
                padding: 30px 22px;
                border-radius: 12px;
            }

            .signup-heading {
                font-size: 29px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            .signup-card {
                animation: none;
            }

            .signup-btn,
            .form-control {
                transition: none;
            }
        }
    </style>
</head>

<body>
    <%- include("./partials/nav") %>

    <main class="signup-wrapper">
        <div class="signup-card">

            <!-- Brand -->
            <div class="brand">
                <div class="brand-icon">
                    <i class="bi bi-book-half"></i>
                </div>

                <div>
                    <div class="brand-name">Blog App.</div>
                    <div class="brand-tagline">
                        THE ART OF STORYTELLING
                    </div>
                </div>
            </div>

            <!-- Heading -->
            <h1 class="signup-heading">
                Create your account
            </h1>

            <p class="signup-description">
                Join a community of readers, thinkers, and
                storytellers. Your next chapter starts here.
            </p>

            <!-- Signup form -->
            <form action="/user/signup" method="post">

                <div class="mb-4">
                    <label for="fullName" class="form-label">
                        Full Name
                    </label>

                    <input
                        type="text"
                        class="form-control"
                        name="fullName"
                        id="fullName"
                        placeholder="Enter your full name"
                        autocomplete="name"
                        required
                    >
                </div>

                <div class="mb-4">
                    <label for="email" class="form-label">
                        Email Address
                    </label>

                    <input
                        type="email"
                        class="form-control"
                        name="email"
                        id="email"
                        placeholder="you@example.com"
                        autocomplete="email"
                        required
                    >
                </div>

                <div class="mb-4">
                    <label for="password" class="form-label">
                        Password
                    </label>

                    <input
                        type="password"
                        class="form-control"
                        name="password"
                        id="password"
                        placeholder="Create a secure password"
                        autocomplete="new-password"
                        required
                    >
                </div>

                <button type="submit" class="signup-btn">
                    Create Account &rarr;
                </button>
            </form>

            <p class="login-text">
                Already have an account?
                <a href="/user/signin" class="login-link">
                    Log in
                </a>
            </p>

            <div class="signup-footer">
                YOUR NEXT CHAPTER STARTS HERE
            </div>

        </div>
    </main>

    <%- include("./partials/script") %>
</body>
</html>